# Arcanum example environment.
# Copy to .env and fill in locally. NEVER commit .env or real credentials.
# Empty values disable the corresponding optional feature; path overrides are
# commented out because the defaults are resolved by the application.

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
# Default runtime directory is ~/.arcanum. Uncomment to override with an
# ABSOLUTE path (~ is not expanded by the Python settings loader):
# ARCANUM_HOME=/absolute/path/to/.arcanum
# Optional explicit database paths (default to files under ARCANUM_HOME):
# ARCANUM_DB=/absolute/path/to/arcanum.db
# ARCANUM_APPROVAL_DB=/absolute/path/to/arcanum-approvals.sqlite
# ARCANUM_TAB_REGISTRY_DB=/absolute/path/to/arcanum-tabs.sqlite
# ARCANUM_ROOT=/absolute/path/to/arcanum-checkout

ARCANUM_LLM_PROVIDER=opencode          # opencode (default) or ollama
ARCANUM_ALLOWED_OPERATORS=local_operator
ARCANUM_TARGET_ALLOWLIST=              # comma-separated domains; optional
DYNAMIC_TARGET_MODE=operator_declared   # or target_allowlist_only
ARCANUM_REQUIRE_MEDIUM_APPROVAL=0

# ---------------------------------------------------------------------------
# Maestro and OpenCode paths
# ---------------------------------------------------------------------------
# MAESTRO_CLI=/absolute/path/to/maestro-cli   # default: ~/.local/bin/maestro-cli
# OPENCODE_CLI=/absolute/path/to/opencode      # default: ~/.opencode/bin/opencode
MAESTRO_HEAD_AGENT=hackbot-lead

# Optional local Ollama provider (only used when ARCANUM_LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Tool endpoints (local services, start separately when needed)
# ---------------------------------------------------------------------------
ARCANUM_BURP_MCP_URL=http://127.0.0.1:9876/mcp
ARCANUM_CAIDO_URL=http://127.0.0.1:8080/graphql

# ---------------------------------------------------------------------------
# Dashboard / harness tokens
# ---------------------------------------------------------------------------
# Replace with long, locally generated random values before using the dashboard.
DASHBOARD_TOKEN=
INGEST_TOKEN=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Discord bridge
# ---------------------------------------------------------------------------
# Create a bot with the Message Content intent enabled; copy IDs from Discord
# Developer Mode. Set a user allowlist explicitly; the bridge's --check reports
# NOT READY when ALLOWED_USER_IDS is empty.
DISCORD_BOT_TOKEN=
ALLOWED_USER_IDS=                       # comma-separated Discord user IDs
ALLOWED_CHANNEL_IDS=                    # comma-separated Discord channel IDs

# ---------------------------------------------------------------------------
# Provider keys (placeholders only)
# ---------------------------------------------------------------------------
# Arcanum itself uses the OpenCode/Maestro provider configuration. These are
# placeholders for provider SDKs you explicitly configure in your environment;
# leave them empty unless your chosen provider requires them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
